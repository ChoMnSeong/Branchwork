  rm -f "$HOOK_DISPATCHER"
  [ ${#ACC_IDS[@]} -gt 0 ] && remove_managed_rules "${ACC_IDS[*]}"
  if grep -q '# >>> gitsw >>>' "$ZSHRC" 2>/dev/null; then backup_file "$ZSHRC"; remove_marked_block "$ZSHRC" "# >>> gitsw >>>" "# <<< gitsw <<<"; fi
  ai_remove
