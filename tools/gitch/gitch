CLAUDE_ALLOW='["Bash(gitch ck:*)","Bash(gitch check:*)","Bash(gitch status:*)","Bash(gitch st:*)","Bash(gitch preflight:*)","Bash(gitch l:*)","Bash(gitch log:*)","Bash(gitch d:*)","Bash(gitch diff:*)","Bash(gitch doctor:*)","Bash(gitch list:*)","Bash(gitch report:*)","Bash(gitch audit:*)","Bash(gitch help)","Bash(gitch version)","Bash(gitch ci)","Bash(gitch rescue)","Bash(gitch c:*)","Bash(gitch commit:*)","Bash(gitch cp:*)","Bash(gitch p:*)","Bash(gitch push:*)","Bash(gitch pl)","Bash(gitch pull)","Bash(gitch up)","Bash(gitch b:*)","Bash(gitch branch:*)","Bash(gitch wt:*)","Bash(gitch continue)","Bash(gitch sync)","Bash(gitch clone:*)","Bash(gitch pr:*)","Bash(git status:*)","Bash(git diff:*)","Bash(git log:*)","Bash(git show:*)","Bash(git blame:*)","Bash(git grep:*)","Bash(git ls-files:*)","Bash(git rev-parse:*)","Bash(git fetch:*)","Bash(git add:*)","Bash(git commit:*)","Bash(git push:*)","Bash(git pull:*)","Bash(git branch:*)","Bash(git switch:*)","Bash(git checkout:*)","Bash(git restore:*)","Bash(git stash:*)","Bash(git remote:*)"]'
