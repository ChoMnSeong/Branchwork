  gitch doctor [--json] [--no-net]         문제 진단
  gitch version / gitch self-update        버전 / 업데이트

종료코드: 0 정상, 1 문제/실패, 2 사용자 확인 필요(--yes), 3 커밋할 것 없음, 4 올릴 파일을 고르지 않음
EOF
}

menu_cmd() {
  load_config >/dev/null 2>&1
  say "${BOLD}gitch${RESET}  ($(account_names))"
  echo "  1) 이 저장소 계정 전환 + 잠금"
  echo "  2) clone"
  echo "  3) fork 해서 clone"
  echo "  4) 현재 저장소 상태"
  echo "  5) 등록된 계정 (접속 확인)"
  echo "  6) 저장소 전체 점검 ($CFG_SCAN_ROOT)"
  echo "  7) 문제 진단"
  echo "  8) 계정 추가"
  echo "  9) 전체 설치/갱신"
  echo "  h) 전체 명령 보기"
  local menu src
  read -r -p "번호: " menu
  case "$menu" in
    1) need_config; select_account; use_cmd "$SA_ID" ;;
    2) clone_cmd ;;
    3) need_config; select_account; read -r -p "원본 저장소 (owner/repo 또는 주소): " src; fork_cmd "$SA_ID" "$src" ;;
    4) status_cmd ;;
    5) list_cmd --check ;;
    6) scan_cmd ;;
    7) doctor_cmd ;;
    8) add_cmd ;;
    9) install_cmd ;;
    h|H) help_cmd ;;
    *) die "잘못된 선택입니다." ;;
  esac
}

# ================= 명령줄 =================

detect_actor
setup_colors

case "${1:-}" in
  help|-h|--help) help_cmd; exit 0 ;;
  version|-v|--version) version_cmd; exit 0 ;;
  c|commit) shift; commit_cmd "$@"; rc=$?; [ $rc -eq 3 ] && rc=0; exit $rc ;;
  p|push) shift; push_cmd "$@"; exit $? ;;
  cp) shift; commit_push_cmd "$@"; exit $? ;;
  pl|pull) pull_cmd; exit $? ;;
  up) up_cmd; exit $? ;;
  ck|check) shift; check_cmd "$@"; exit $? ;;
  preflight|pf) shift; preflight_cmd "$@"; exit $? ;;
  l|log) log_cmd "${2:-}"; exit $? ;;
  d|diff) shift; diff_cmd "$@"; exit 0 ;;
  b|branch) branch_cmd "${2:-}"; exit $? ;;
  undo) undo_cmd; exit $? ;;
  amend) shift; amend_cmd "$@"; exit $? ;;
  continue) continue_cmd; exit $? ;;
  abort) shift; abort_cmd "$@"; exit $? ;;
  rescue) shift; rescue_cmd "$@"; exit $? ;;
  o|open) open_cmd; exit $? ;;
  pr|mr) shift; pr_cmd "$@"; exit $? ;;
  ci) ci_cmd; exit $? ;;
  publish) shift; publish_cmd "$@"; exit $? ;;
  status|st) shift; status_cmd "$@"; exit $? ;;
  use) use_cmd "${2:-}"; exit $? ;;
  unlock) shift; unlock_cmd "$@"; exit $? ;;
  ignore) shift; ignore_cmd "$@"; exit $? ;;
  protect) shift; protect_cmd "$@"; exit $? ;;
  clone) shift; clone_cmd "$@"; exit $? ;;
  fork) shift; fork_cmd "$@"; exit $? ;;
  sync) sync_cmd; exit $? ;;
  fix) fix_cmd "${2:-}"; exit $? ;;
  scan) shift; scan_cmd "$@"; exit $? ;;
  audit) shift; audit_cmd "$@"; exit $? ;;
  prune) shift; prune_cmd "$@"; exit $? ;;
  wt|worktree) shift; wt_cmd "$@"; exit $? ;;
  report) shift; report_cmd "$@"; exit $? ;;
  list|ls) shift; list_cmd "$@"; exit $? ;;
  add) add_cmd; exit $? ;;
  remove|rm) remove_cmd "${2:-}"; exit $? ;;
  org) shift; org_cmd "$@"; exit $? ;;
  config) shift; config_cmd "$@"; exit $? ;;
  setup) setup_cmd "${2:-}"; exit $? ;;
  auto) install_auto_rules; exit $? ;;
  sign) sign_cmd "${2:-}" "${3:-}"; exit $? ;;
  ai) shift; ai_cmd "$@"; exit $? ;;
  ssh) shift; ssh_cmd "$@"; exit $? ;;
  install) install_cmd; exit $? ;;
  uninstall) shift; uninstall_cmd "$@"; exit $? ;;
  migrate) shift; migrate_cmd "$@"; exit $? ;;
  export) export_cmd "${2:-}"; exit $? ;;
  import) shift; import_cmd "$@"; exit $? ;;
  doctor) shift; doctor_cmd "$@"; exit $? ;;
  self-update) self_update_cmd; exit $? ;;
  guard) shift; guard_cmd "$@"; exit 0 ;;
  _hook) shift; hook_main "$@"; exit $? ;;
  "") menu_cmd; exit $? ;;
  *) err "알 수 없는 명령: $1"; help_cmd; exit 1 ;;
esac
