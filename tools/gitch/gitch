read -r -d '' REPORT_AWK <<'AWKEOF'
function jget(l, k,   re, v) {
  re = "\"" k "\":\"([^\"\\\\]|\\\\.)*\""
  if (match(l, re)) {
    v = substr(l, RSTART + length(k) + 4, RLENGTH - length(k) - 5)
    gsub(/\\"/, "\"", v); gsub(/\\\\/, "\\", v)
    return v
  }
  return ""
}
{
  ts = jget($0, "ts"); if (ts < s) next
  ev = jget($0, "event"); ac = jget($0, "actor"); repo = jget($0, "repo"); acc = jget($0, "account")
  if (index(repo, home) == 1) repo = "~" substr(repo, length(home) + 1)
  if (repo == "") repo = "(저장소 밖)"
  cnt[ac SUBSEP ev]++; actors[ac] = 1
  if (!(repo in seen)) { seen[repo] = 1; order[++nr] = repo }
  det = ""
  if (ev == "commit") det = jget($0, "sha") " \"" jget($0, "subject") "\""
  else if (ev == "push") det = jget($0, "remote")
  else if (ev == "pr" || ev == "clone") det = jget($0, "url")
  else if (ev == "fix") det = jget($0, "count") "개"
  t = substr(ts, 6, 5) " " substr(ts, 12, 5)
  rows[repo] = rows[repo] sprintf("    %s  %-7s %-8s %-12s %s\n", t, ac, ev, acc, det)
  total++
}
END {
  if (total == 0) { print "기록 없음 (" s " 이후)"; exit }
  print "gitch 작업 기록 (" s " 이후, " total "건)"
  for (a in actors) {
    line = "  " a ":"
    for (k in cnt) { split(k, p, SUBSEP); if (p[1] == a) line = line " " p[2] " " cnt[k] }
    print line
  }
  for (i = 1; i <= nr; i++) { print ""; print "  " order[i]; printf "%s", rows[order[i]] }
}
AWKEOF

report_cmd() {   # [--today | --days N | --since YYYY-MM-DD] [--json]
  local since json=""
  since=$(date +%Y-%m-%d)
  while [ $# -gt 0 ]; do
    case "$1" in
      --today) since=$(date +%Y-%m-%d) ;;
      --days) shift; is_number "$1" || die "--days 뒤에 숫자가 필요합니다."; since=$(date -v-"$1"d +%Y-%m-%d 2>/dev/null || date -d "-$1 days" +%Y-%m-%d) ;;
      --since) shift; since="$1" ;;
      --json) json=1 ;;
      *) die "사용법: gitch report [--today | --days N | --since YYYY-MM-DD] [--json]" ;;
    esac
    shift
  done
  if [ ! -f "$ACTION_LOG" ]; then
    if [ -n "$json" ]; then echo "[]"; else say "아직 기록이 없습니다. ($(tilde "$ACTION_LOG"))"; fi
    return 0
  fi
  if [ -n "$json" ]; then
    awk -v s="$since" 'BEGIN { printf "["; n = 0 } { if (match($0, /"ts":"[^"]*"/)) { ts = substr($0, RSTART + 6, RLENGTH - 7); if (ts >= s) { printf "%s%s", (n++ ? "," : ""), $0 } } } END { print "]" }' "$ACTION_LOG"
    return 0
  fi
  awk -v s="$since" -v home="$HOME" "$REPORT_AWK" "$ACTION_LOG"
}

version_cmd() {
  local dir d
  dir=$(dirname "$(self_path)")
  d=$(git -C "$dir" describe --always --dirty --tags 2>/dev/null)
  say "gitch $GITSW_VERSION${d:+ ($d)} — $(tilde "$(self_path)")"
}

GITCH_RELEASES="Gitrochi/Gitrochi"   # 따로 받은 gitch 가 업데이트를 받는 곳 (tools/gitch/install.sh 와 같음)

# 릴리스 목록(GitHub API)에서 초안·시험판이 아니고 gitch 가 든 첫(가장 새) 릴리스 → "태그 주소"
# Windows 만 고친 릴리스가 최신일 수 있어서 releases/latest 를 쓰지 않는다. tools/gitch/install.sh 와 같은 내용.
RELEASE_AWK='
/^[[:space:]]*"tag_name":/ { tag = $0; sub(/^[^:]*:[[:space:]]*"/, "", tag); sub(/".*/, "", tag); skip = 0 }
/^[[:space:]]*"(draft|prerelease)":[[:space:]]*true/ { skip = 1 }
/^[[:space:]]*"browser_download_url":.*\/gitch"/ && !skip { url = $0; sub(/^[^:]*:[[:space:]]*"/, "", url); sub(/".*/, "", url); print tag, url; exit }'

curl_get() { curl -fsSL --connect-timeout 15 --max-time 120 "$@"; }
sha256_of() { { shasum -a 256 "$1" 2>/dev/null || sha256sum "$1"; } | awk '{ print $1 }'; }
ver_lt() {   # $1 이 $2 보다 낮은 버전인지 (3.0.9 < 3.0.10)
  local IFS=. i x y a b
  read -r -a a <<< "$1"; read -r -a b <<< "$2"
  for i in 0 1 2 3; do
    x=${a[$i]:-0}; y=${b[$i]:-0}
    is_number "$x" || x=0; is_number "$y" || y=0
    [ "$x" -lt "$y" ] && return 0
    [ "$x" -gt "$y" ] && return 1
  done
  return 1
}

self_update_cmd() {   # 따로 받은 gitch 만 바꾼다 — 앱에 든 것은 앱과 함께, 저장소(git)의 것은 그 저장소와 함께(git pull 은 앱 저장소 전체를 바꾸므로 하지 않음)
  local self dir
  self=$(self_path); dir=$(dirname "$self")
  case "$self" in
    *.app/Contents/*) ;;
    *) git -C "$dir" ls-files --error-unmatch -- "$(basename "$self")" >/dev/null 2>&1 || { self_update_standalone "$self"; return $?; } ;;
  esac
  say "gitch 는 Gitrochi 앱과 함께 업데이트됩니다(앱의 자동 업데이트). 저장소(tools/gitch)에서 쓰고 있다면 그 저장소를 직접 받으세요."
  say "지금: $(tilde "$self") (v$GITSW_VERSION)"
}

UPDATE_TMP=""
self_update_standalone() {   # $1 이 파일 — 릴리스의 gitch 를 gitch.sha256 과 맞춰 본 뒤 같은 폴더의 임시 파일 → mv (돌고 있는 셸은 원래 파일을 계속 읽음)
  local self="$1" dir json tag url want have new
  dir=$(dirname "$self")
  command -v curl >/dev/null 2>&1 || die "curl 이 필요합니다."
  json=$(curl_get -H 'Accept: application/vnd.github+json' "https://api.github.com/repos/$GITCH_RELEASES/releases?per_page=20") \
    || die "릴리스 목록을 받지 못했습니다: https://github.com/$GITCH_RELEASES/releases"
  read -r tag url <<< "$(printf '%s\n' "$json" | tr ',' '\n' | awk "$RELEASE_AWK")"
  [ -n "$url" ] || die "gitch 가 든 릴리스가 아직 없습니다: https://github.com/$GITCH_RELEASES/releases"
  UPDATE_TMP=$(mktemp "$dir/.gitch-update.XXXXXX") || die "$(tilde "$dir") 에 쓸 수 없어 바꾸지 못했습니다."
  trap 'rm -f "$UPDATE_TMP" "$UPDATE_TMP.sha256"' EXIT
  curl_get -o "$UPDATE_TMP" "$url" && curl_get -o "$UPDATE_TMP.sha256" "$url.sha256" || die "받지 못했습니다: $url"
  want=$(awk '$2 == "gitch" || $2 == "*gitch" { print $1; exit }' "$UPDATE_TMP.sha256")
  have=$(sha256_of "$UPDATE_TMP")
  [ -n "$want" ] && [ "$want" = "$have" ] || die "SHA-256 이 gitch.sha256 과 맞지 않아 바꾸지 않았습니다 ($tag)"
  new=$(sed -n 's/^GITSW_VERSION="\([^"]*\)".*/\1/p' "$UPDATE_TMP" | head -1)
  [ -n "$new" ] && "${BASH:-bash}" -n "$UPDATE_TMP" 2>/dev/null || die "받은 파일이 gitch 가 아닙니다: $url"
  if [ "$have" = "$(sha256_of "$self")" ]; then ok "이미 최신입니다: gitch $GITSW_VERSION ($tag)"; return 0; fi
  if ver_lt "$new" "$GITSW_VERSION"; then
    say "지금 gitch($GITSW_VERSION)가 릴리스 $tag 의 gitch($new)보다 새 버전이라 그대로 뒀습니다."
    return 0
  fi
  chmod 755 "$UPDATE_TMP" && mv -f "$UPDATE_TMP" "$self" || die "바꾸지 못했습니다: $(tilde "$self")"
  ok "gitch $GITSW_VERSION → $new ($tag): $(tilde "$self")"
  dim "  AI 규칙·스킬·검사 훅도 새 버전으로 쓰려면: gitch install"
  log_action self-update "from=$GITSW_VERSION" "to=$new" "release=$tag"
}

