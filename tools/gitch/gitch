migrate_cmd() {   # [기존 gitch(v1) 경로] [--force]
  local src="" force="" a line id email host port tmp root
  for a in "$@"; do case "$a" in --force) force=1 ;; *) src="$a" ;; esac; done
  [ -f "$CFG" ] && [ -z "$force" ] && die "설정 파일이 이미 있습니다: $(tilde "$CFG") (덮어쓰려면 --force)"
  if [ -z "$src" ]; then
    for a in "$HOME/Develop/gitsw" "$(dirname "$(self_path)")/gitsw.v1"; do
      if [ -f "$a" ] && [ "$(resolve_link "$a")" != "$(self_path)" ] && grep -q '^ACCOUNTS=(' "$a" 2>/dev/null; then src="$a"; break; fi
    done
  fi
  { [ -n "$src" ] && [ -f "$src" ]; } || die "옮길 기존 gitch(v1) 파일을 찾지 못했습니다. 사용법: gitch migrate <기존 gitch 경로>"
  grep -q '^ACCOUNTS=(' "$src" || die "v1 gitch 파일이 아닙니다: $src"
  tmp=$(mktemp "${TMPDIR:-/tmp}/gitsw-migrate.XXXXXX") || die "임시 파일을 만들 수 없습니다."
  cfg_header > "$tmp"
  root=$(sed -n 's/^SCAN_ROOT="\(.*\)"$/\1/p' "$src" | head -1)
  [ -n "$root" ] && git config -f "$tmp" gitsw.scanRoot "$root"
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    IFS='|' read -r id email host port <<< "$line"
    [ -z "$id" ] && continue
    host=${host:-github.com}
    [ -n "$port" ] && [ "$port" != 22 ] && host="$host:$port"
    git config -f "$tmp" "account.$id.email" "$email"
    git config -f "$tmp" --add "account.$id.host" "$host"
  done < <(awk '/^ACCOUNTS=\(/ { f = 1; next } f && /^\)/ { f = 0 } f' "$src" | sed -E 's/^[[:space:]]*"//; s/"[[:space:]]*$//')
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    git config -f "$tmp" "folder.${line%%|*}.account" "${line#*|}"
  done < <(awk '/^FOLDERS=\(/ { f = 1; next } f && /^\)/ { f = 0 } f' "$src" | sed -E 's/^[[:space:]]*"//; s/"[[:space:]]*$//')
  if ! GITSW_CONFIG="$tmp" "$(self_path)" config check >/dev/null 2>&1; then
    GITSW_CONFIG="$tmp" "$(self_path)" config check 2>&1 | sed 's/^/  /' >&2
    rm -f "$tmp"; die "옮긴 설정에 문제가 있어 멈췄습니다."
  fi
  mkdir -p "$(dirname "$CFG")"
  [ -f "$CFG" ] && backup_file "$CFG"
  mv "$tmp" "$CFG"
  ok "v1 설정을 옮겼습니다: $(tilde "$src") → $(tilde "$CFG")"
  reset_config_state; load_config
  say "  계정: $(account_names)"
  say "다음: gitch install  (조직 규칙 추가: gitch org add github.com/<조직> <계정>)"
}

export_cmd() {   # [파일] — 설정만 (SSH 키 제외)
  [ -f "$CFG" ] || die "설정 파일이 없습니다: $(tilde "$CFG")"
  if [ -n "$1" ]; then cp "$CFG" "$1" && ok "설정을 내보냈습니다: $1"
  else cat "$CFG"; fi
  dim "  (SSH 키는 포함하지 않습니다 — 새 컴퓨터에서는 gitch import 후 gitch setup 으로 키를 만들고 등록하세요)" >&2
}

import_cmd() {   # <파일> [--yes]
  local f="" yes="" a
  for a in "$@"; do case "$a" in --yes) yes=1 ;; *) f="$a" ;; esac; done
  [ -n "$f" ] && [ -f "$f" ] || die "사용법: gitch import <설정 파일>"
  can_prompt || [ -n "$yes" ] || die "설정 가져오기는 사용자가 터미널에서 직접 실행해야 합니다."
  GITSW_CONFIG="$f" "$(self_path)" config check >/dev/null 2>&1 || { GITSW_CONFIG="$f" "$(self_path)" config check 2>&1 | sed 's/^/  /' >&2; die "가져올 설정에 문제가 있습니다."; }
  [ -f "$CFG" ] && confirm "지금 설정($(tilde "$CFG"))을 바꿉니다 (백업 남김). 계속할까요?" "$yes" "gitch import $f --yes"
  mkdir -p "$(dirname "$CFG")"
  backup_file "$CFG"
  cp "$f" "$CFG"
  ok "설정을 가져왔습니다. 이어서: gitch install, gitch setup (SSH 키)"
}

