CLAUDE_ALLOW_OLD='["Bash(gitch ck)","Bash(gitch status)","Bash(gitch preflight)","Bash(gitch l)","Bash(gitch d)","Bash(gitch doctor)","Bash(gitch list)","Bash(gitch b)","Bash(gitch pr status:*)","Bash(gitsw ck)","Bash(gitsw status)","Bash(gitsw preflight)","Bash(gitsw l)","Bash(gitsw d)","Bash(gitsw doctor)","Bash(gitsw list)","Bash(gitsw b)","Bash(gitsw pr status:*)","Bash(gitsw ck:*)","Bash(gitsw check:*)","Bash(gitsw status:*)","Bash(gitsw st:*)","Bash(gitsw preflight:*)","Bash(gitsw l:*)","Bash(gitsw log:*)","Bash(gitsw d:*)","Bash(gitsw diff:*)","Bash(gitsw doctor:*)","Bash(gitsw list:*)","Bash(gitsw report:*)","Bash(gitsw audit:*)","Bash(gitsw help)","Bash(gitsw version)","Bash(gitsw ci)","Bash(gitsw rescue)","Bash(gitsw c:*)","Bash(gitsw commit:*)","Bash(gitsw cp:*)","Bash(gitsw p:*)","Bash(gitsw push:*)","Bash(gitsw pl)","Bash(gitsw pull)","Bash(gitsw up)","Bash(gitsw b:*)","Bash(gitsw branch:*)","Bash(gitsw wt:*)","Bash(gitsw continue)","Bash(gitsw sync)","Bash(gitsw clone:*)","Bash(gitsw pr:*)"]'
JQ_CLAUDE_INSTALL='
  def notgitsw: ((.hooks // []) | map((.command // "") | test("(gitch|gitsw)\"? guard")) | any) | not;
  .hooks = (.hooks // {})
  | .hooks.PreToolUse = (((.hooks.PreToolUse // []) | map(select(notgitsw))) + [
      {"matcher": "Bash", "hooks": [{"type": "command", "command": $cmd, "timeout": 15}]},
      {"matcher": "Edit|Write|MultiEdit|NotebookEdit", "hooks": [{"type": "command", "command": $cmd, "timeout": 15}]}
    ])
  | .permissions = (.permissions // {})
  | .permissions.allow = (((.permissions.allow // []) | map(select(. as $x | ($old | any(.[]; . == $x)) | not))) as $kept
      | reduce $allow[] as $x ($kept; if any(.[]; . == $x) then . else . + [$x] end))'
JQ_CLAUDE_REMOVE='
  def notgitsw: ((.hooks // []) | map((.command // "") | test("(gitch|gitsw)\"? guard")) | any) | not;
  (if .hooks.PreToolUse then .hooks.PreToolUse |= map(select(notgitsw)) else . end)
  | (if .hooks.PreToolUse == [] then del(.hooks.PreToolUse) else . end)
  | (if .hooks == {} then del(.hooks) else . end)
  | (if .permissions.allow then .permissions.allow |= map(select(. as $x | ($allow | any(.[]; . == $x)) | not)) else . end)
  | (if .permissions.allow == [] then del(.permissions.allow) else . end)
  | (if .permissions == {} then del(.permissions) else . end)'

write_claude_settings() {
  [ -d "$CLAUDE_DIR" ] || return 0
  command -v jq >/dev/null 2>&1 || { warn "jq 가 없어 Claude Code 검사 훅을 설치하지 못했습니다 (brew install jq)"; return 1; }
  local f="$CLAUDE_DIR/settings.json" tmp cmd
  cmd="\"$(gitsw_cmd_path)\" guard --claude"
  if [ -f "$f" ]; then
    jq empty "$f" >/dev/null 2>&1 || { warn "$(tilde "$f") 이 올바른 JSON 이 아니라 건드리지 않았습니다"; return 1; }
    backup_file "$f"
  fi
  tmp=$(mktemp "${TMPDIR:-/tmp}/gitsw-claude.XXXXXX") || return 1
  if { if [ -f "$f" ]; then cat "$f"; else echo '{}'; fi; } | jq --arg cmd "$cmd" --argjson allow "$CLAUDE_ALLOW" --argjson old "$CLAUDE_ALLOW_OLD" "$JQ_CLAUDE_INSTALL" > "$tmp"; then
    cat "$tmp" > "$f"
    say "  ${GREEN}✔${RESET} Claude Code 명령 검사 훅 + 읽기 명령 허용: $(tilde "$f")"
  else
    warn "Claude Code 설정을 바꾸지 못했습니다: $(tilde "$f")"
  fi
  rm -f "$tmp"
}

ai_remove() {
  local f tmp d
  for f in "$CLAUDE_DIR/CLAUDE.md" "$CODEX_DIR/AGENTS.md" "$GEMINI_DIR/GEMINI.md"; do
    grep -q 'gitsw:begin' "$f" 2>/dev/null || continue
    backup_file "$f"; remove_marked_block "$f" "<!-- gitsw:begin" "<!-- gitsw:end -->"
  done
  for d in "$CLAUDE_DIR" "$CODEX_DIR"; do rm -rf "$d/skills/gitch"; remove_legacy_skill "$d"; done
  f="$CLAUDE_DIR/settings.json"
  if [ -f "$f" ] && command -v jq >/dev/null 2>&1 && jq empty "$f" >/dev/null 2>&1; then
    backup_file "$f"
    tmp=$(mktemp "${TMPDIR:-/tmp}/gitsw-claude.XXXXXX") || return 1
    jq --argjson allow "$(jq -cn --argjson a "$CLAUDE_ALLOW" --argjson b "$CLAUDE_ALLOW_OLD" '$a + $b')" "$JQ_CLAUDE_REMOVE" "$f" > "$tmp" && cat "$tmp" > "$f"
    rm -f "$tmp"
  fi
}

ai_cmd() {
  case "${1:-}" in
    --print) need_config; gen_ai_block ;;
