{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Branchwork",
  "version": "0.3.5",
  "identifier": "io.github.chomnseong.branchwork",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Branchwork",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 640,
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "ChoMnSeong",
    "copyright": "© 2026 조문성 (ChoMnSeong) · MIT License",
    "category": "DeveloperTool",
    "shortDescription": "Git client with a commit graph, worktrees, PRs, Claude Code agents and a terminal",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "icons/app/*.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc5NDM1NjRENkZGQzE5RjkKUldUNUdmeHZUVlpEZWNqRzZqdTFKTmRSUmZVc3hKTkYxanB2Y09xQTJ0OVU1Q3lYVGxlNW5LOGsK",
      "endpoints": [
        "https://github.com/ChoMnSeong/Branchwork/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
