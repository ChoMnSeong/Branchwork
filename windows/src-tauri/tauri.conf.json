{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Branchwork",
  "version": "0.1.0",
  "identifier": "io.github.chomnseong.branchwork",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Branchwork",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 640,
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "ChoMnSeong",
    "copyright": "© 2026 조문성 (ChoMnSeong) · MIT License",
    "category": "DeveloperTool",
    "shortDescription": "Git client with a commit graph, worktrees, PRs, Claude Code agents and a terminal",
    "license": "MIT",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
